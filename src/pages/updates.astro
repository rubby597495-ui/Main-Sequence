---
import BaseLayout from '../components/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SourceList from '../components/SourceList.astro';
import { UPDATES } from '../data/updates';
import { GAME_IMAGES } from '../lib/images';
import { SITE } from '../data/site';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Updates', path: '/updates/' },
];

const years = ['2026', '2025'];
const typeClass: Record<string, string> = {
  Release: 'text-signal border-signal/60',
  Demo: 'text-scanner border-scanner/50',
  Patch: 'text-fog border-line',
  Playtest: 'text-fog border-line',
  Development: 'text-mist border-line',
};
const sourceIds = Array.from(new Set(UPDATES.map((entry) => entry.sourceId)));
const latest = UPDATES[0];
---

<BaseLayout
  title="Main Sequence Updates & Patch Notes: 2025–2026 Timeline"
  description="A source-linked timeline of Main Sequence announcements, demo updates, playtests and patches, including the November 12, 2026 Early Access release date."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
>
  <PageIntro
    eyebrow="Signal log"
    title="Main Sequence updates and patch notes"
    description="A dated log of official announcements, demo changes and balance patches. No invented future roadmap, no fake freshness."
    breadcrumbs={breadcrumbs}
    image={GAME_IMAGES['main-sequence-freighter-departure.jpg']}
    imageAlt="A Main Sequence freighter departing a station under its own engines"
    imageCaption="The update log tracks public communications and patch notes, not unannounced development work."
    meta={['Official sources only', 'Last checked November 1, 2026', 'Newest entry: October 21, 2026']}
  />

  <div class="wrap grid gap-12 py-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:py-14">
    <div class="min-w-0">
      <div class="panel p-5 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="font-mono text-[0.57rem] uppercase tracking-[0.12em] text-signal">
            Latest official entry
          </p>
          <p class="mt-2 font-display text-2xl font-semibold uppercase text-paper">
            {latest.title}
          </p>
          <p class="mt-1 font-mono text-[0.58rem] uppercase tracking-[0.08em] text-mist">
            {latest.date} · {latest.type}
          </p>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-mist">{latest.summary}</p>
      </div>

      <div class="mt-6 callout callout-info">
        <span class="callout-title">How this log works</span>
        <p class="m-0 text-sm">
          We add entries only when there is an official announcement, patch note
          or storefront change to point to. Dates refer to the publication date.
          The absence of an entry does not mean the developer is inactive; it
          means we did not find a verifiable public update.
        </p>
      </div>

      {
        years.map((year) => {
          const entries = UPDATES.filter((entry) => entry.date.startsWith(year));
          if (!entries.length) return null;
          return (
            <section class="mt-12" aria-labelledby={`year-${year}`}>
              <div class="flex items-center gap-4 border-b border-line pb-3">
                <h2 id={`year-${year}`} class="display text-4xl text-paper">
                  {year}
                </h2>
                <span class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-mist">
                  {entries.length} verified entries
                </span>
              </div>

              <div class="mt-2">
                {entries.map((entry) => (
                  <article class="grid gap-4 border-b border-line-soft py-6 md:grid-cols-[7rem_1fr] md:gap-8">
                    <div>
                      <time
                        datetime={entry.date}
                        class="font-mono text-[0.65rem] uppercase tracking-[0.06em] text-paper"
                      >
                        {entry.date}
                      </time>
                      <div class="mt-2">
                        <span class={`badge ${typeClass[entry.type] ?? ''}`}>
                          {entry.type}
                        </span>
                      </div>
                    </div>
                    <div>
                      <h3 class="font-display text-2xl font-semibold uppercase leading-none text-paper">
                        {entry.title}
                      </h3>
                      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-mist">
                        {entry.summary}
                      </p>
                      <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                        {entry.links?.map((link) => (
                          <a href={link.href} class="arrow-link">
                            {link.label}
                          </a>
                        ))}
                        <a
                          href={`/sources/#${entry.sourceId}`}
                          class="evidence-link font-mono text-[0.57rem] uppercase tracking-[0.08em] text-mist hover:text-signal"
                        >
                          Source note ↗
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }

      <SourceList
        ids={sourceIds}
        title="Update log sources"
        intro="Each entry in the signal log is tied to one of these official announcements or the store listing used for launch facts."
      />

      <div class="mt-10 border-t border-line-soft pt-6">
        <p class="font-mono text-[0.6rem] uppercase tracking-[0.12em] text-signal">
          Official channels
        </p>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a
            href={SITE.game.steam}
            target="_blank"
            rel="noopener noreferrer"
            class="text-link"
          >
            Steam store page
          </a>
          <a
            href="https://store.steampowered.com/newshub/app/2487190"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link"
          >
            Steam news hub
          </a>
          <a
            href={SITE.game.officialSite}
            target="_blank"
            rel="noopener noreferrer"
            class="text-link"
          >
            Official game site
          </a>
        </div>
      </div>
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-28 border border-line-soft bg-night p-5">
        <p class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-signal">
          Update status
        </p>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-mono text-[0.55rem] uppercase tracking-[0.06em] text-mist">Last official entry</dt>
            <dd class="mt-1 text-fog">{latest.date}</dd>
          </div>
          <div>
            <dt class="font-mono text-[0.55rem] uppercase tracking-[0.06em] text-mist">Early Access</dt>
            <dd class="mt-1 text-fog">November 12, 2026</dd>
          </div>
          <div>
            <dt class="font-mono text-[0.55rem] uppercase tracking-[0.06em] text-mist">Demo</dt>
            <dd class="mt-1 text-fog">Live on Steam</dd>
          </div>
        </dl>
        <p class="mt-4 border-t border-line-soft pt-4 text-xs leading-relaxed text-mist">
          Page checked {SITE.lastVerifiedLabel}. We only change the log when a new
          verifiable source appears.
        </p>
        <a href="/release-date/" class="arrow-link mt-4">Launch details</a>
      </div>
    </aside>
  </div>
</BaseLayout>
