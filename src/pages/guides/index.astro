---
import { Image } from 'astro:assets';
import BaseLayout from '../../components/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { GUIDES } from '../../data/guides';
import { GAME_IMAGES, getGameImage } from '../../lib/images';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
];

const featured = GUIDES[0];
const startGuideLinks = [
  {
    href: '/demo/',
    title: 'Demo guide: what is playable now',
    description:
      'Scope, access, co-op status, saves and the practical route through the current demo.',
    tag: 'Demo dossier',
  },
  {
    href: '/guides/first-station-logistics/',
    title: 'The conveyor belt fix',
    description:
      'Power the station, finish Logistics I and finally build the first working belt line.',
    tag: 'Common blocker',
  },
];
const coreGuides = GUIDES.filter(
  (guide) => guide.level === 'Core systems',
);
const otherGuides = GUIDES.filter(
  (guide) => guide.level === 'Multiplayer' || guide.level === 'Reference',
);
---

<BaseLayout
  title="Main Sequence Guides: Beginner, Factory, Ships & Co-op"
  description="Browse Main Sequence guides for the demo and Early Access: first station, conveyor belts, factory layout, ship design, combat, research and co-op roles."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
>
  <PageIntro
    eyebrow="Field library"
    title="Main Sequence guides and field notes"
    description="Practical routes through the demo and confirmed systems, written to be useful while the game is still changing. Start with the blocker you have, not with a 40-tab spreadsheet."
    breadcrumbs={breadcrumbs}
    image={GAME_IMAGES['main-sequence-cockpit-station.jpg']}
    imageAlt="A Main Sequence cockpit view looking toward a station in orbit above a planet"
    imageCaption="The field library covers the demo, station systems, ships, combat and multiplayer. Official Steam screenshot."
    meta={['Demo-focused', 'Source-checked', 'No filler entity pages']}
  />

  <div class="wrap py-12 md:py-16">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Start here"
        title="The first three reads"
        description="If you are new, the demo dossier explains what is available. The beginner guide gives you the route, and the station guide fixes the point where that route usually jams."
      />
      <a href="/tools/demo-checklist/" class="arrow-link">Track your demo run</a>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
      <a
        href={featured.href}
        class="group border border-line-soft bg-deep"
      >
        <div class="relative aspect-[16/8] overflow-hidden">
          <Image
            src={getGameImage(featured.image)}
            alt={featured.imageAlt ?? ''}
            widths={[640, 960, 1400]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            format="webp"
            quality={80}
            loading="eager"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
          />
          <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(7,16,23,0.9),rgba(7,16,23,0)_65%)]" aria-hidden="true"></div>
          <span class="absolute left-4 top-4 badge badge-confirmed">Start here</span>
        </div>
        <div class="relative -mt-14 p-5 md:p-7">
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-signal">
            Primary briefing
          </p>
          <h2 class="mt-2 font-display text-3xl font-semibold uppercase text-paper group-hover:text-signal md:text-4xl">
            {featured.title}
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mist">
            {featured.description}
          </p>
          <span class="arrow-link mt-5">Open the briefing</span>
        </div>
      </a>

      <div class="grid gap-5">
        {
          startGuideLinks.map((guide) => (
            <a
              href={guide.href}
              class="group flex flex-col justify-between border border-line-soft bg-night p-5 transition-colors hover:border-signal md:p-6"
            >
              <div>
                <p class="font-mono text-[0.57rem] uppercase tracking-[0.12em] text-signal">
                  {guide.tag}
                </p>
                <h2 class="mt-3 font-display text-2xl font-semibold uppercase text-paper group-hover:text-signal">
                  {guide.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-mist">
                  {guide.description}
                </p>
              </div>
              <span class="arrow-link mt-6">Read field note</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <section class="border-y border-line-soft bg-night">
    <div class="wrap py-12 md:py-16">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="Core systems"
          title="Factory, ships and defense"
          description="Pages for the systems you will actually operate in the demo and the Early Access build."
        />
        <a href="/database/" class="arrow-link">Open the database</a>
      </div>

      <div class="mt-8 border-t border-line">
        {
          coreGuides.map((guide, index) => (
            <a
              href={guide.href}
              class="group grid gap-4 border-b border-line-soft py-6 md:grid-cols-[4rem_10rem_1fr_auto] md:items-center md:gap-6"
            >
              <span class="font-mono text-[0.62rem] text-[#6f8892]">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="relative aspect-[16/10] overflow-hidden border border-line-soft">
                <Image
                  src={getGameImage(guide.image)}
                  alt={guide.imageAlt ?? ''}
                  widths={[280, 480, 800]}
                  sizes="(min-width: 768px) 160px, 100vw"
                  format="webp"
                  quality={74}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div>
                <p class="font-mono text-[0.56rem] uppercase tracking-[0.1em] text-signal">
                  {guide.eyebrow}
                </p>
                <h3 class="mt-2 font-display text-2xl font-semibold uppercase text-paper group-hover:text-signal">
                  {guide.title}
                </h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-mist">
                  {guide.description}
                </p>
              </div>
              <span class="font-mono text-xs text-signal">Open ↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="wrap py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div>
        <SectionHeading
          eyebrow="Multiplayer & reference"
          title="For shared crews and deeper reading"
          description="The co-op page includes a working session planner. The research page is the reference version of the demo technology tree."
        />
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          {
            otherGuides.map((guide) => (
              <a
                href={guide.href}
                class="group border border-line-soft bg-deep p-5 transition-colors hover:border-signal"
              >
                <p class="font-mono text-[0.56rem] uppercase tracking-[0.1em] text-signal">
                  {guide.eyebrow}
                </p>
                <h3 class="mt-3 font-display text-2xl font-semibold uppercase text-paper group-hover:text-signal">
                  {guide.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-mist">
                  {guide.description}
                </p>
                <span class="arrow-link mt-5">Open</span>
              </a>
            ))
          }
        </div>
      </div>

      <aside class="border border-line-soft bg-night p-6">
        <div class="eyebrow mb-3">Editorial boundary</div>
        <h2 class="font-display text-3xl font-semibold uppercase text-paper">
          What we are not publishing yet
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-mist">
          The game does not currently provide enough verified named entities
          for a character encyclopedia, a monster bestiary, a quest walkthrough
          database or a complete weapon stats table. We would rather leave those
          pages unbuilt than invent names, stats and locations.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-mist">
          Once the Early Access build exposes stable data, the database can grow
          into those categories with real pages rather than keyword duplicates.
        </p>
        <a href="/editorial-policy/" class="arrow-link mt-5">Read the policy</a>
      </aside>
    </div>
  </div>

  <div class="border-t border-line-soft">
    <div class="wrap flex flex-col items-start justify-between gap-6 py-10 md:flex-row md:items-center">
      <p class="max-w-2xl text-sm leading-relaxed text-mist">
        Need a single answer instead of a guide? The release page covers date,
        price and platforms. The source archive lists every reference used across
        the site.
      </p>
      <div class="flex flex-wrap gap-5">
        <a href="/release-date/" class="arrow-link">Release status</a>
        <a href="/sources/" class="arrow-link">Source archive</a>
      </div>
    </div>
  </div>
</BaseLayout>
