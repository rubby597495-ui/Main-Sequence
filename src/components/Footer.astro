---
import { SITE } from '../data/site';
import { UPDATES } from '../data/updates';

const latest = UPDATES[0];
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line bg-night">
  <div class="wrap py-12 md:py-16">
    <div class="grid gap-12 border-b border-line-soft pb-12 lg:grid-cols-[1.3fr_0.8fr_0.8fr_0.8fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <img
            src="/icons/mark.svg"
            width="40"
            height="40"
            alt=""
            class="h-9 w-9 border border-line-soft"
          />
          <span class="font-display text-2xl font-bold uppercase leading-none text-paper">
            Main Sequence<br />
            <span class="text-signal">Field Guide</span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-mist">
          An independent, source-checked wiki and field manual for the
          first-person space factory sim. We separate confirmed facts from
          community findings and label the unknowns.
        </p>
        <p class="mt-5 max-w-sm font-mono text-[0.59rem] leading-relaxed tracking-[0.04em] text-mist">
          Not affiliated with or endorsed by Tumbling Dumpling Studio or
          Mythwright. Game names and imagery remain the property of their
          respective owners.
        </p>
      </div>

      <div>
        <h2 class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-signal">
          Explore
        </h2>
        <ul class="mt-4 space-y-2 text-sm text-mist">
          <li><a class="hover:text-paper" href="/game/">Game overview</a></li>
          <li><a class="hover:text-paper" href="/release-date/">Release status</a></li>
          <li><a class="hover:text-paper" href="/demo/">Demo guide</a></li>
          <li><a class="hover:text-paper" href="/beginner-guide/">Beginner's guide</a></li>
          <li><a class="hover:text-paper" href="/guides/">All guides</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-signal">
          Reference
        </h2>
        <ul class="mt-4 space-y-2 text-sm text-mist">
          <li><a class="hover:text-paper" href="/database/">Database index</a></li>
          <li><a class="hover:text-paper" href="/database/resources/">Resources</a></li>
          <li><a class="hover:text-paper" href="/database/modules/">Modules</a></li>
          <li><a class="hover:text-paper" href="/database/research/">Research tree</a></li>
          <li><a class="hover:text-paper" href="/tools/">Tools</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-signal">
          Site
        </h2>
        <ul class="mt-4 space-y-2 text-sm text-mist">
          <li><a class="hover:text-paper" href="/about/">About</a></li>
          <li><a class="hover:text-paper" href="/editorial-policy/">Editorial policy</a></li>
          <li><a class="hover:text-paper" href="/sources/">Sources</a></li>
          <li><a class="hover:text-paper" href="/contact/">Contact</a></li>
          <li><a class="hover:text-paper" href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-5 pt-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-mono text-[0.58rem] uppercase tracking-[0.1em] text-mist">
          Latest official transmission · {latest.date}
        </p>
        <a class="mt-1 inline-block text-sm text-fog hover:text-signal" href="/updates/">
          {latest.title}
        </a>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.56rem] uppercase tracking-[0.08em] text-mist">
        <span>© {year} {SITE.name}</span>
        <a class="hover:text-signal" href={SITE.game.steam} target="_blank" rel="noopener noreferrer">
          Steam ↗
        </a>
        <a class="hover:text-signal" href={SITE.game.officialSite} target="_blank" rel="noopener noreferrer">
          Official site ↗
        </a>
        <span>Images: official press/Steam media</span>
      </div>
    </div>
  </div>
</footer>
