---
interface Props {
  targetId: string;
  categories: string[];
  placeholder?: string;
  label?: string;
}

const {
  targetId,
  categories,
  placeholder = 'Search this database…',
  label = 'Filter entries',
} = Astro.props;
---

<div
  class="filter-root"
  data-filter-root
  data-filter-target={targetId}
  aria-label={label}
>
  <div class="filter-controls hidden">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <label class="relative block w-full md:max-w-sm">
        <span class="sr-only">{placeholder}</span>
        <input
          type="search"
          class="filter-input pl-9"
          placeholder={placeholder}
          data-filter-search
          autocomplete="off"
        />
        <span
          aria-hidden="true"
          class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 font-mono text-xs text-signal"
        >
          /
        </span>
      </label>
      <p
        class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-mist"
        data-filter-count
        aria-live="polite"
      >
      </p>
    </div>
    <div class="mt-3 flex gap-2 overflow-x-auto pb-1 no-scrollbar" role="group" aria-label="Category filters">
      <button
        type="button"
        class="filter-chip"
        data-filter-value="all"
        aria-pressed="true"
      >
        All
      </button>
      {
        categories.map((category) => (
          <button
            type="button"
            class="filter-chip"
            data-filter-value={category}
            aria-pressed="false"
          >
            {category}
          </button>
        ))
      }
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    if (window.__msFiltersLoaded) return;
    window.__msFiltersLoaded = true;

    const init = () => {
    const roots = document.querySelectorAll('[data-filter-root]');
    roots.forEach((root) => {
      const target = document.getElementById(root.dataset.filterTarget);
      if (!target) return;

      const controls = root.querySelector('.filter-controls');
      if (controls) controls.classList.remove('hidden');

      const rows = Array.from(target.querySelectorAll('tbody tr[data-row]'));
      const search = root.querySelector('[data-filter-search]');
      const count = root.querySelector('[data-filter-count]');
      const empty = target.querySelector('[data-filter-empty]');
      const buttons = Array.from(root.querySelectorAll('[data-filter-value]'));
      let activeCategory = 'all';

      const apply = () => {
        const query = (search?.value || '').trim().toLowerCase();
        let visible = 0;

        rows.forEach((row) => {
          const categoryMatch =
            activeCategory === 'all' ||
            row.dataset.category === activeCategory;
          const haystack = (row.dataset.search || row.textContent || '').toLowerCase();
          const queryMatch = !query || haystack.includes(query);
          const show = categoryMatch && queryMatch;
          row.hidden = !show;
          if (show) visible += 1;
        });

        if (empty) empty.hidden = visible !== 0;
        if (count) {
          count.textContent = `${visible} of ${rows.length} entries`;
        }
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          activeCategory = button.dataset.filterValue || 'all';
          buttons.forEach((item) => {
            item.setAttribute(
              'aria-pressed',
              item === button ? 'true' : 'false',
            );
          });
          apply();
        });
      });

      if (search) {
        search.addEventListener('input', apply);
      }

      apply();
    });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
