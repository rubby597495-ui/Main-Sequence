---
interface Props {
  variant?: 'compact' | 'full';
  class?: string;
}

const { variant = 'compact', class: className = '' } = Astro.props;
const target = '2026-11-12T16:00:00Z';
---

<div
  class={`countdown ${variant === 'full' ? 'countdown-full' : ''} ${className}`.trim()}
  data-countdown
  data-target={target}
  role="timer"
  aria-label="Countdown to the estimated Main Sequence Early Access unlock"
>
  <div class="flex items-end justify-between gap-4">
    <div>
      <div class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-signal">
        Estimated unlock
      </div>
      <div class="mt-1 font-display text-2xl font-semibold uppercase leading-none text-paper">
        November 12, 2026
      </div>
    </div>
    <div class="hidden font-mono text-[0.58rem] uppercase tracking-[0.08em] text-mist xs:block">
      16:00 UTC*
    </div>
  </div>

  <div class="mt-5 grid grid-cols-4 gap-px bg-line" data-countdown-digits>
    {
      [
        ['data-days', 'Days'],
        ['data-hours', 'Hours'],
        ['data-minutes', 'Min'],
        ['data-seconds', 'Sec'],
      ].map(([attribute, label]) => (
        <div class="bg-void px-2 py-3 text-center">
          <span
            class="block font-display text-3xl font-semibold leading-none text-paper md:text-4xl"
            {...{ [attribute]: true }}
          >
            --
          </span>
          <span class="mt-1 block font-mono text-[0.53rem] uppercase tracking-[0.1em] text-mist">
            {label}
          </span>
        </div>
      ))
    }
  </div>

  <p
    class="mt-3 hidden font-display text-2xl font-semibold uppercase text-signal"
    data-countdown-live
  >
    Early Access is live
  </p>

  {
    variant === 'full' ? (
      <p class="mt-4 max-w-lg text-xs leading-relaxed text-mist">
        SteamDB lists a store timestamp of 16:00 UTC. The publisher has not
        confirmed the exact unlock hour. Your local equivalent is{' '}
        <span class="text-fog" data-countdown-local>
          calculated in your browser
        </span>
        .
      </p>
    ) : (
      <p class="mt-3 font-mono text-[0.55rem] leading-relaxed tracking-[0.04em] text-mist">
        *Unofficial 16:00 UTC store timestamp. Date is official.
      </p>
    )
  }
</div>

<script is:inline>
  (() => {
    if (window.__msCountdownLoaded) return;
    window.__msCountdownLoaded = true;

    const elements = Array.from(document.querySelectorAll('[data-countdown]'));
    if (!elements.length) return;

    const pad = (value) => String(value).padStart(2, '0');
    const formatUnit = (value) => pad(Math.max(0, value));

    const tick = () => {
      const now = Date.now();
      elements.forEach((element) => {
        const target = new Date(element.dataset.target).getTime();
        const remaining = target - now;
        const digitWrap = element.querySelector('[data-countdown-digits]');
        const liveMessage = element.querySelector('[data-countdown-live]');
        const local = element.querySelector('[data-countdown-local]');

        if (local) {
          local.textContent = new Intl.DateTimeFormat(
            document.documentElement.lang || 'en-US',
            {
              dateStyle: 'medium',
              timeStyle: 'short',
            },
          ).format(new Date(target));
        }

        if (Number.isNaN(target)) return;

        if (remaining <= 0) {
          if (digitWrap) digitWrap.hidden = true;
          if (liveMessage) liveMessage.classList.remove('hidden');
          return;
        }

        if (digitWrap) digitWrap.hidden = false;
        if (liveMessage) liveMessage.classList.add('hidden');

        const days = Math.floor(remaining / 86400000);
        const hours = Math.floor((remaining % 86400000) / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        const seconds = Math.floor((remaining % 60000) / 1000);

        const values = [
          ['data-days', days],
          ['data-hours', hours],
          ['data-minutes', minutes],
          ['data-seconds', seconds],
        ];

        values.forEach(([selector, value]) => {
          const node = element.querySelector(`[${selector}]`);
          if (node) node.textContent = formatUnit(value);
        });
      });
    };

    tick();
    setInterval(tick, 1000);
  })();
</script>
