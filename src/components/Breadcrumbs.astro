---
interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  items: Breadcrumb[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[0.62rem] uppercase tracking-[0.09em] text-mist">
    {
      items.map((item, index) => {
        const isCurrent = index === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true" class="text-line">/</span>}
            {isCurrent ? (
              <span aria-current="page" class="text-fog">
                {item.name}
              </span>
            ) : (
              <a class="transition-colors hover:text-signal" href={item.path}>
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
