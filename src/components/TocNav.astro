---
interface Item {
  id: string;
  label: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="On this page" class={className}>
  <p class="mb-3 font-mono text-[0.58rem] font-semibold uppercase tracking-[0.14em] text-signal">
    On this page
  </p>
  <ul class="toc-nav space-y-0.5">
    {
      items.map((item) => (
        <li>
          <a class="toc-link" href={`#${item.id}`}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
